# ---------- Application ----------
PORT=              # port that the API listens on (default: 3000)
CORS_ORIGINS=      # allowed origins, comma-separated e.g. http://localhost:3000,http://localhost:3001
FRONTEND_URL=      # exact frontend URL to redirect to after a successful Google callback, e.g. http://localhost:5173/auth/google/callback
SWAGGER_USERNAME=  # username required to open /api and /api-json
SWAGGER_PASSWORD=  # password required to open /api and /api-json

# ---------- Database ----------
DATABASE_URL=      # PostgreSQL connection string (Neon: append ?sslmode=require)

# ---------- Auth ----------
JWT_SECRET=        # secret used to sign JWT access tokens (REQUIRED in production)
GOOGLE_CLIENT_ID=      # Google OAuth client ID
GOOGLE_CLIENT_SECRET=  # Google OAuth client secret
GOOGLE_REDIRECT_URI=   # exact backend callback URL registered in Google Cloud

# ---------- Email (Resend) ----------
RESEND_API_KEY=    # Resend API key, used to send OTP emails (REQUIRED - app crashes at startup if missing)

# ---------- Private Cloudflare R2 file storage ----------
STORAGE_ENDPOINT=          # https://<account-id>.r2.cloudflarestorage.com
STORAGE_REGION=auto        # R2 uses auto for S3 API signing
STORAGE_BUCKET=            # private bucket name
STORAGE_ACCESS_KEY_ID=     # R2 API token access key ID, with object read/write permissions
STORAGE_SECRET_ACCESS_KEY= # R2 API token secret access key

# ---------- Local docker-compose only ----------
# ไม่ต้อง set ตอน deploy ขึ้น production ใช้เฉพาะ docker-compose.yml ในเครื่อง
SOFTWARE_PASSWORD= # password for the local PostgreSQL 'postgres' user
ADMIN_EMAIL=       # email used to log in to pgAdmin
ADMIN_PASSWORD=    # password used to log in to pgAdmin
