# ---------- Application ----------
PORT=              # port that the API listens on (default: 3000)
CORS_ORIGINS=      # allowed origins, comma-separated e.g. http://localhost:3000,http://localhost:3001

# ---------- Database ----------
DATABASE_URL=      # PostgreSQL connection string (Neon: append ?sslmode=require)

# ---------- Auth ----------
JWT_SECRET=        # secret used to sign JWT access tokens (REQUIRED in production)

# ---------- Email (Resend) ----------
RESEND_API_KEY=    # Resend API key, used to send OTP emails (REQUIRED - app crashes at startup if missing)

# ---------- Local docker-compose only ----------
# ไม่ต้อง set ตอน deploy ขึ้น production ใช้เฉพาะ docker-compose.yml ในเครื่อง
SOFTWARE_PASSWORD= # password for the local PostgreSQL 'postgres' user
ADMIN_EMAIL=       # email used to log in to pgAdmin
ADMIN_PASSWORD=    # password used to log in to pgAdmin
