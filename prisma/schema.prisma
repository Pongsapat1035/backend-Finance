// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                    Int                    @id @default(autoincrement())
  email                 String                 @unique
  name                  String?
  password              String
  status                UserStatus             @default(UNVERIFIED)
  bannedAt              DateTime?
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  otps                  Otp[]
  categories            Category[]
  transactions          Transaction[]
  recurringTransactions RecurringTransaction[]
}

model Otp {
  id           Int      @id @default(autoincrement())
  userId       Int
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expireAt     DateTime
  otp          String
  referral     String
  attempts     Int      @default(0)
  resend_count Int      @default(0)
  purpose      OtpType
}

model Transaction {
  id          Int              @id @default(autoincrement())
  type        TransactionType
  /// Amount in Thai satang (1/100 THB); for example, 12345 represents ฿123.45.
  amount                 Int
  description            String
  date                   DateTime
  categoryId             Int
  category               Category         @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  createdAt              DateTime         @default(now())
  updatedAt              DateTime         @updatedAt
  userId                 Int
  users                  User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  recurringTransactionId Int?
  recurringTransaction   RecurringTransaction? @relation(fields: [recurringTransactionId], references: [id], onDelete: SetNull)
}

model Category {
  id                    Int                    @id @default(autoincrement())
  title                 String
  type                  TransactionType
  users                 User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions          Transaction[]
  recurringTransactions RecurringTransaction[]
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  userId                Int

  @@unique([userId, title, type])
}

model RecurringTransaction {
  id          Int      @id @default(autoincrement())
  userId      Int
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  categoryId  Int
  category    Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  title       String
  description String?
  /// Amount in Thai satang (1/100 THB); for example, 12345 represents ฿123.45.
  amount      Int
  /// Calendar day for this monthly expense. Application validation must allow only 1 through 31.
  dayOfMonth  Int
  startDate   DateTime
  endDate     DateTime?
  nextRunAt   DateTime
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  transactions Transaction[]

  @@index([userId, isActive, nextRunAt])
}

enum TransactionType {
  EXPEND     @map("expend")
  INCOME     @map("income")
  INVESTMENT @map("investment")
}

enum OtpType {
  EMAIL @map("verify_email")
}

enum UserStatus {
  UNVERIFIED @map("unverified")
  VERIFIED   @map("verified")
  BANNED     @map("banned")
}
